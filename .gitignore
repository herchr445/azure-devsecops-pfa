# Terraform sensitive files - NEVER commit these
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/backup*/
terraform/*.tfstate*

# SSH Keys - NEVER commit
*.pem
*.key
id_rsa
id_rsa.pub

# Environment files
.env
*.env

# OS files
.DS_Store
Thumbs.db

# Python scripts output - NEVER commit
scripts/app.env
scripts/health_check_results.log
scripts/infrastructure_report.txt
*.envinfrastructure_report.txt 
